<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oled_black"
    android:padding="16dp">

    <!-- Top Header Layout with Exit Button (Samsung / Realme Style) -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clockView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm a"
                android:format24Hour="HH:mm"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/dateView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, MMMM d"
                android:format24Hour="EEEE, MMMM d"
                android:textColor="@color/subtext_gray"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Exit Super Power Saving Button -->
        <LinearLayout
            android:id="@+id/btnExitMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_exit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Exit"
                android:textColor="@color/power_red"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ⚡ NEXT-LEVEL BATTERY & CHARGING TELEMETRY HUD (Tap to open Graph) -->
    <LinearLayout
        android:id="@+id/cardBatteryHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card_oled"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBarLayout">

        <!-- Header: Charging Speed Title & Battery % -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivChargingIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_charging_bolt" />

            <TextView
                android:id="@+id/tvChargingHeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="⚡ 18W Fast Charging"
                android:textColor="@color/eco_green"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPowerState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_dark"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="10% Mode"
                android:textColor="@color/eco_green"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvBatteryPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="78%"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Primary Telemetry Row: Wattage | Current | Voltage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Wattage Box -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tvWattageVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18.5 W"
                    android:textColor="@color/eco_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POWER"
                    android:textColor="@color/subtext_gray"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Current Box -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tvCurrentVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+3850 mA"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT"
                    android:textColor="@color/subtext_gray"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Voltage Box -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tvVoltageVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.28 V"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOLTAGE"
                    android:textColor="@color/subtext_gray"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Secondary Info Row: Temp | Charger Type | Est. Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTempVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌡️ 31.5°C"
                android:textColor="@color/subtext_gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvChargerTypeVal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="• AC Adapter"
                android:textColor="@color/subtext_gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTimeToFullVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ ~24m to 100%"
                android:textColor="@color/eco_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 1% Extreme Blackout Mode Feature Card -->
    <LinearLayout
        android:id="@+id/cardExtremeModeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_oled"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/cardBatteryHud">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvExtremeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/extreme_mode_banner_title"
                android:textColor="@color/power_orange"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExtremeSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calls &amp; SMS only • Monochrome • Ringtone works"
                android:textColor="@color/subtext_gray"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggleExtreme"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_button_eco"
            android:text="Go Extreme"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Emergency / Phone Priority Card -->
    <LinearLayout
        android:id="@+id/cardEmergencyPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_oled"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/cardExtremeModeBanner">

        <ImageView
            android:id="@+id/ivPhoneIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_phone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emergency_phone"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tap_to_call"
                android:textColor="@color/subtext_gray"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Emergency / SMS Priority Card (Visible in Extreme Mode) -->
    <LinearLayout
        android:id="@+id/cardEmergencySms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_oled"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cardEmergencyPhone">

        <ImageView
            android:id="@+id/ivSmsIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_sms" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emergency_sms"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tap_to_sms"
                android:textColor="@color/subtext_gray"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Whitelisted 6 Apps Section Header -->
    <LinearLayout
        android:id="@+id/sectionAppsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/cardEmergencySms">

        <TextView
            android:id="@+id/tvAllowedHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/allowed_apps_header"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfigureApps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_dark"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="Edit (6)"
            android:textColor="@color/eco_green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Grid / List for the 6 Allowed Apps -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAllowedApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/bottomControlsLayout"
        app:layout_constraintTop_toBottomOf="@id/sectionAppsHeader" />

    <!-- Bottom Controls & OS Setup -->
    <LinearLayout
        android:id="@+id/bottomControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvPowerTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:text="@string/power_saving_tips"
            android:textColor="@color/subtext_gray"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPermissionSetup"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark"
                android:text="@string/btn_power_settings"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnTogglePowerMode"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_eco"
                android:text="Toggle 10% Mode"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Permissions Screen / Prompts -->
    <string name="perm_notification_title">Notification Access Required</string>
    <string name="perm_notification_desc">Required to intercept &amp; silence unwanted notifications from waking the phone.</string>
    <string name="perm_grant_btn">Grant Access</string>
    <string name="perm_granted">Active &amp; Protecting</string>
    <string name="perm_write_settings_title">Modify System Settings</string>
    <string name="perm_write_settings_desc">Required to auto-dim screen and lower screen timeout to 15 seconds.</string>
    <string name="perm_battery_opt_title">Ignore Battery Optimization</string>
    <string name="perm_battery_opt_desc">Allows Super Power Saver engine to maintain power gatekeeping continuously.</string>
    
    <!-- Accessibility Kiosk -->
    <string name="accessibility_desc">Enforces Super Power Saving Mode by blocking unauthorized apps from running and waking the CPU.</string>
    <string name="perm_accessibility_title">3. Kiosk App Blocker (Realme/Samsung Style)</string>
    <string name="perm_accessibility_desc">Blocks unauthorized apps outside your whitelist from opening.</string>
    <string name="perm_home_title">4. Set Default Home Launcher</string>
    <string name="perm_home_desc">Prevents exiting to heavy OS launcher when pressing Home button.</string>


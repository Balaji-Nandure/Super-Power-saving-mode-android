    <!-- App Selection Screen -->
    <string name="title_select_apps">Select Whitelisted Apps</string>
    <string name="select_apps_limit_info">Choose up to 25 apps. All other apps will be blocked from sending background wake-up notifications.</string>
    <string name="search_hint">Search installed apps...</string>
